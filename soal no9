// Soal 9 - Arrow Function
// Menghitung Luas Segitiga

// Membuat arrow function
const hitungLuasSegitiga = (alas, tinggi) => 0.5 * alas * tinggi;

// Memanggil function dengan angka yang sudah diganti
let luasSegitiga = hitungLuasSegitiga(12, 9);
console.log("Alas: 12, Tinggi: 9");
console.log("Luas Segitiga:", luasSegitiga);

// Coba satu lagi biar makin beda
let luasSegitiga2 = hitungLuasSegitiga(14, 10);
console.log("\nAlas: 14, Tinggi: 10");
console.log("Luas Segitiga:", luasSegitiga2);