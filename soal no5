// Soal 5 - Function
// Menghitung Luas Persegi Panjang

// Membuat function hitungLuasPersegiPanjang
function hitungLuasPersegiPanjang(panjang, lebar) {
  let luas = panjang * lebar;
  return luas; // Mengembalikan hasil
}

// Memanggil function dengan angka yang sudah diganti
let hasil1 = hitungLuasPersegiPanjang(12, 7);
console.log("Luas Persegi Panjang (12 x 7):", hasil1);

let hasil2 = hitungLuasPersegiPanjang(15, 8);
console.log("Luas Persegi Panjang (15 x 8):", hasil2);