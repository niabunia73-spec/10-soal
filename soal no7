// Soal 7 - String Manipulation

// Nama awal - udah aku ganti jadi nama kamu
const nama = "  bunia  ";

// 1. Menghilangkan spasi di awal dan akhir
let namaBersih = nama.trim();
console.log("Nama setelah di-trim:", namaBersih);

// 2. Mengubah nama menjadi huruf besar
let namaBesar = namaBersih.toUpperCase();
console.log("Huruf Besar:", namaBesar);

// 3. Mengubah nama menjadi huruf kecil
let namaKecil = namaBersih.toLowerCase();
console.log("Huruf Kecil:", namaKecil);

// 4. Menghitung jumlah karakter setelah spasi dihilangkan
let jumlahKarakter = namaBersih.length;
console.log("Jumlah Karakter:", jumlahKarakter);