// Soal 10 - Switch Case
// Menentukan Nama Hari

// Input hari - aku pake 5 biar beda
let nomorHari = 5;
let namaHari;

switch (nomorHari) {
  case 1:
    namaHari = "Senin";
    break;
  case 2:
    namaHari = "Selasa";
    break;
  case 3:
    namaHari = "Rabu";
    break;
  case 4:
    namaHari = "Kamis";
    break;
  case 5:
    namaHari = "Jumat";
    break;
  case 6:
    namaHari = "Sabtu";
    break;
  case 7:
    namaHari = "Minggu";
    break;
  default:
    namaHari = "Nomor hari tidak valid! Harus 1-7";
}

console.log("Nomor Hari:", nomorHari);
console.log("Nama Hari:", namaHari);