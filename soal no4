// Soal 4 - Perulangan (Looping)
// Angka 1 sampai 100

let jumlahGenap = 0; // Buat nampung total angka genap

console.log("=== Angka Genap ===");
for (let i = 1; i <= 100; i++) {
  if (i % 2 === 0) {
    console.log(i);
    jumlahGenap += i; // Jumlahin angka genapnya
  }
}

console.log("\n=== Angka Ganjil ===");
for (let i = 1; i <= 100; i++) {
  if (i % 2 !== 0) {
    console.log(i);
  }
}

console.log("\nJumlah Seluruh Angka Genap dari 1-100:", jumlahGenap);