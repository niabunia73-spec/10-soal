// Soal 6 - Array

// Data nilai - udah aku ganti biar beda dari contoh
const nilai = [88, 72, 95, 60, 78, 92, 85, 68];

// 1. Menampilkan seluruh nilai
console.log("Seluruh Nilai:", nilai);

// 2. Mencari nilai tertinggi dan terendah
let nilaiTertinggi = Math.max(...nilai);
let nilaiTerendah = Math.min(...nilai);
console.log("Nilai Tertinggi:", nilaiTertinggi);
console.log("Nilai Terendah:", nilaiTerendah);

// 3. Menghitung rata-rata
let totalNilai = 0;
for (let i = 0; i < nilai.length; i++) {
  totalNilai += nilai[i];
}
let rataRata = totalNilai / nilai.length;
console.log("Rata-rata:", rataRata);

// 4. Menghitung jumlah mahasiswa yang lulus (nilai >= 75)
let jumlahLulus = 0;
for (let i = 0; i < nilai.length; i++) {
  if (nilai[i] >= 75) {
    jumlahLulus++;
  }
}
console.log("Jumlah Mahasiswa yang Lulus:", jumlahLulus);