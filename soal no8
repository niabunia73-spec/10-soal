// Soal 8 - Object

// Data mahasiswa - udah aku ganti biar beda dari contoh
const mahasiswa = {
  nama: "Bunia",
  umur: 19,
  jurusan: "Sistem Informasi",
  nilai: 88
};

// 1. Menampilkan seluruh data mahasiswa
console.log("Data Awal Mahasiswa:", mahasiswa);

// 2. Mengubah nilai menjadi 92
mahasiswa.nilai = 92;
console.log("Setelah Nilai Diubah:", mahasiswa);

// 3. Menambah properti baru status dengan nilai "Lulus"
mahasiswa.status = "Lulus";
console.log("Setelah Ditambah Status:", mahasiswa);

// Biar lebih rapi, tampilkan satu-satu juga
console.log("\nNama:", mahasiswa.nama);
console.log("Umur:", mahasiswa.umur);
console.log("Jurusan:", mahasiswa.jurusan);
console.log("Nilai:", mahasiswa.nilai);
console.log("Status:", mahasiswa.status);